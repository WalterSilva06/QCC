{
  "verificar": [
    { "nombre": "validate", "cmd": "claude plugin validate qcc-panel" },
    { "nombre": "test", "cmd": "claude plugin test qcc-panel", "rutas": ["qcc-panel/**"] },
    { "nombre": "test flujos", "cmd": "node --test \"qcc-implementador/herramientas/*.test.mjs\"", "rutas": ["qcc-implementador/**"], "paralelo": true },
    { "nombre": "test qcc-commit", "cmd": "node --test qcc-commit/herramientas/solo-git.test.mjs", "rutas": ["qcc-commit/**"], "paralelo": true },
    { "nombre": "test impl-d", "cmd": "node --test \"qcc-impl-directo/herramientas/*.test.mjs\"", "rutas": ["qcc-impl-directo/**"], "paralelo": true },
    { "nombre": "test impl-l", "cmd": "node --test \"qcc-impl-largo/herramientas/*.test.mjs\"", "rutas": ["qcc-impl-largo/**"], "paralelo": true }
  ],
  "criticos": [
    {
      "rutas": ["qcc-implementador/", "qcc-commit/"],
      "excepto": ["qcc-implementador/agents/*.md", "qcc-commit/agents/*.md", "qcc-implementador/herramientas/config.ejemplo.md"],
      "criterios": [1, 5],
      "motivo": "guardia.mjs es la seguridad de los subagentes; lo demás lo usan todos los proyectos del usuario"
    },
    {
      "rutas": ["qcc-implementador/agents/*.md", "qcc-commit/agents/*.md"],
      "criterios": [1, 5],
      "si": "cambia su frontmatter (herramientas, modelo)",
      "motivo": "definición de los agentes del flujo"
    },
    {
      "rutas": [".claude/qcc-implementador/", ".claude/qcc-implementador.json", ".claude/implementador/", ".claude/implementador.json"],
      "criterios": [1],
      "motivo": "reglas y config de este flujo: «guardia» afloja o aprieta la guardia"
    },
    {
      "rutas": ["qcc-panel/hooks/flujo.ts", "qcc-panel/types/index.d.ts"],
      "criterios": [6],
      "motivo": "máquina de estado del flujo y forma de los atoms que sobreviven a /reload-plugins"
    },
    {
      "rutas": ["qcc-panel/hooks/register.tsx"],
      "criterios": [7],
      "motivo": "hooks que envuelven next: un fallo frena una petición al modelo o una herramienta"
    }
  ]
}
