    { "rutas": ["qcc-implementador-odd/"], "excepto": ["qcc-implementador-odd/agents/*.md", "qcc-implementador-odd/herramientas/guardia.mjs"], "riesgo": [3, 5], "motivo": "herramientas, prompts e instalador de /qcc-implementador-odd, que usan todos los proyectos del usuario" },
