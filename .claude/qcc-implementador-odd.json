    { "rutas": ["qcc-implementador/", "qcc-commit/"], "excepto": ["qcc-implementador/agents/*.md", "qcc-commit/agents/*.md", "qcc-implementador/herramientas/config.ejemplo.md"], "riesgo": [2, 3], "motivo": "/qcc-implementador, /qcc-commit y sus guardias, que usan todos los proyectos del usuario" },
    { "rutas": ["qcc-implementador/agents/*.md", "qcc-commit/agents/*.md"], "si": "cambia su frontmatter (herramientas, modelo)", "riesgo": [2, 3], "motivo": "definición de los agentes de /qcc-implementador y /qcc-commit" },
    { "rutas": [".claude-plugin/", "qcc/"], "riesgo": [5], "motivo": "marketplace y paquete que instalan los plugins" },
    { "rutas": [".claude/"], "riesgo": [2], "motivo": "reglas y config de los flujos en este repo" },
    { "rutas": ["qcc-panel/hooks/flujo.ts", "qcc-panel/types/index.d.ts"], "riesgo": [4], "motivo": "máquina de estado del flujo y forma de los atoms que sobreviven a /reload-plugins" },
    { "rutas": ["qcc-panel/hooks/register.tsx"], "riesgo": [3], "motivo": "hooks que envuelven next: un fallo frena una petición al modelo o una herramienta" }
